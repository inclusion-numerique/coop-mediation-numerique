{
  "name": "coop-mediation-numerique",
  "description": "La Coop de la médiation numérique",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.19"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "predev": "react-dsfr optimize-css --silent",
    "dev": "pnpm --silent with-env next dev",
    "generate:implementations": "./scripts/generate-implementations.sh",
    "prebuild": "react-dsfr optimize-css --silent",
    "build": "pnpm --silent with-env next build",
    "build:jobs": "pnpm --silent with-env node build-jobs.mjs",
    "build:analyze": "ANALYZE=true pnpm --silent with-env next build --webpack",
    "start": "next start",
    "lint": "biome check src && openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json && pnpm -r lint",
    "lint:fix": "biome format src --fix && biome check --write src",
    "lint:api": "openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json",
    "tsc": "tsc --noEmit && pnpm -r tsc",
    "postinstall": "pnpm --silent generate:implementations && DISABLE_ERD=true pnpm --silent prisma generate && pnpm --silent prisma:entrepot:generate",
    "test": "vitest run --project \"!integration\"",
    "test:integration": "vitest run --project integration",
    "test:cucumber": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' dotenv -e ./.env -- cucumber-js",
    "test:cucumber:coverage": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' c8 dotenv -e ./.env -- cucumber-js",
    "with-env": "dotenv --",
    "with-remote-env": "dotenv -e .env.remote -e .env --",
    "prisma": "pnpm --silent with-env prisma",
    "prisma:entrepot:generate": "pnpm --silent prisma generate --config ./prisma/entrepot/prisma.config.ts",
    "db:migrate-deploy": "pnpm --silent db:baseline-main && pnpm --silent prisma migrate deploy && pnpm --silent prisma db execute --file ./prisma/sql/move-prisma-migrations-to-coop.sql",
    "db:baseline-main": "bash ./prisma/baseline-main.sh",
    "db:check-main-drift": "bash ./prisma/main-drift.sh check",
    "db:refresh-main-reference": "bash ./prisma/main-drift.sh refresh",
    "erd": "pnpm erd:md && pnpm erd:svg && pnpm erd:pdf",
    "erd:md": "DISABLE_ERD= pnpm prisma generate",
    "erd:svg": "mmdc -i prisma/ERD.md -o prisma/ERD.svg && mv prisma/ERD-1.svg prisma/ERD.svg",
    "erd:pdf": "mmdc -i prisma/ERD.md -o prisma/ERD.pdf -f && mv prisma/ERD-1.pdf prisma/ERD.pdf",
    "api-v1-doc:generate": "next-swagger-doc-cli --config ./src/app/api/v1/documentation/apiV1DocConfig.json --output ./src/app/api/v1/documentation/v1.openapi.json && biome format --write ./src/app/api/v1/documentation/v1.openapi.json",
    "standalone:configure": "cp -R ./public ./.next/standalone/public && cp -R ./.next/static ./.next/standalone/.next/static",
    "standalone:start": "HOSTNAME=\"0.0.0.0\" ./node_modules/.bin/dotenv -e ./.env -- node ./.next/standalone/server.js",
    "cli": "dotenv -- ./apps/cli/node_modules/.bin/tsx apps/cli/src/index.ts",
    "clean": "rm -rf node_modules",
    "clean:workspaces": "pnpm -r exec rm -rf node_modules",
    "lint:commit": "commitlint --from origin/main",
    "test:e2e": "pnpm -F e2e cy open",
    "scw": "pnpm with-env scw",
    "manypkg": "manypkg",
    "start:web": "pnpm dev",
    "fixtures:load": "pnpm -F fixtures load",
    "prisma:generate-migration": "pnpm --silent prisma migrate dev --name",
    "db:init": "pnpm prisma generate && pnpm db:migrate-deploy",
    "docker:start": "docker compose -p coop up -d",
    "docker:stop": "docker compose -p coop down",
    "docker:reset": "pnpm docker:stop && docker volume rm coop_pgdata && pnpm docker:start && pnpm db:init",
    "prepare": "husky"
  },
  "dependencies": {
    "@app/emails": "workspace:^",
    "@arckit/nextjs": "^2.2.2",
    "@arckit/pipeline": "^1.0.0",
    "@arckit/resultset": "^2.1.0",
    "@arckit/telemetry": "^1.5.0",
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@codegouvfr/react-dsfr": "^1.35.0",
    "@gouvfr-anct/lieux-de-mediation-numerique": "^4.4.0",
    "@gouvfr-anct/timetable-to-osm-opening-hours": "^2.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@next/bundle-analyzer": "^16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@scalar/api-reference-react": "^0.9.87",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-form": "^1.33.5",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@zumer/snapdom": "^3.0.0",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "client-only": "^0.0.1",
    "copy": "^0.3.2",
    "csv-stringify": "^6.8.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debounce-promise": "^3.1.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "downshift": "^9.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.4.0",
    "html-to-text": "^10.0.1",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "lodash-es": "^4.18.1",
    "mjml": "^5.4.1",
    "nanoid": "^6.0.1",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-swagger-doc": "^0.4.1",
    "nodemailer": "^10.0.10",
    "p-retry": "^8.0.1",
    "p-throttle": "^8.1.1",
    "pako": "^3.0.2",
    "pino": "^10.4.0",
    "piqure": "^2.3.0",
    "postcss": "8.5.23",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postgres-array": "3.0.4",
    "prisma": "7.10.0",
    "proj4": "^2.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-calendar": "^6.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "react-use-css-custom-property": "^0.1.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "superjson": "2.2.6",
    "tsafe": "^1.8.12",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arckit/cucumber": "^1.0.1",
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cucumber/cucumber": "^13.2.1",
    "@manypkg/cli": "^0.25.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@storybook/react": "^10.6.0",
    "@superfaceai/openapi-linter": "^0.1.0",
    "@types/debounce-promise": "^3.1.9",
    "@types/html-to-text": "^9.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "modclean": "3.0.0-beta.1",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.5.3",
    "prisma-erd-generator": "^3.2.1",
    "sass": "^1.107.1",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
