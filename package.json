{
  "name": "coop-mediation-numerique",
  "description": "La Coop de la médiation numérique - Monorepo",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.19"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "cli": "dotenv -- ./apps/cli/node_modules/.bin/tsx apps/cli/src/index.ts",
    "clean": "rm -rf node_modules",
    "clean:workspaces": "pnpm -r exec rm -rf node_modules",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
    "lint": "pnpm -r lint",
    "lint:commit": "commitlint --from origin/main",
    "tsc": "pnpm -r tsc",
    "test": "pnpm -r test",
    "test:integration": "pnpm -F web test:integration",
    "test:e2e": "pnpm -F e2e cy open",
    "with-env": "dotenv --",
    "scw": "pnpm with-env scw",
    "manypkg": "manypkg",
    "start:web": "pnpm -F web dev",
    "fixtures:load": "pnpm -F fixtures load",
    "prisma:generate-migration": "pnpm --silent -F @app/web prisma migrate dev --name",
    "db:init": "pnpm -F web prisma generate && pnpm -F web db:migrate-deploy",
    "docker:start": "docker compose -f ./docker-compose.dev.yml -p coop up -d",
    "docker:stop": "docker compose -f ./docker-compose.dev.yml -p coop down",
    "docker:reset": "pnpm docker:stop && docker volume rm coop_pgdata && pnpm docker:start && pnpm db:init",
    "coverage:merge": "rm -rf coverage/.nyc_output && mkdir -p coverage/.nyc_output && find coverage-reports -name '*.json' -exec cp {} coverage/.nyc_output/ \\; && nyc report --temp-dir ./coverage/.nyc_output --reporter=lcov --reporter=html --reporter=text-summary --report-dir=./coverage",
    "prepare": "husky"
  },
  "volta": {
    "node": "24.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@manypkg/cli": "^0.25.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nyc": "^18.0.0",
    "prettier": "^3.9.8"
  }
}
