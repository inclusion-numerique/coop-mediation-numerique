{
  "name": "coop-mediation-numerique",
  "description": "La Coop de la médiation numérique",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "predev": "react-dsfr optimize-css --silent",
    "dev": "pnpm --silent with-env next dev",
    "generate:implementations": "./scripts/generate-implementations.sh",
    "prebuild": "react-dsfr optimize-css --silent",
    "build": "pnpm --silent with-env next build",
    "build:jobs": "pnpm --silent with-env node scripts/build-jobs.mjs",
    "lint": "biome check . && pnpm --silent lint:api && pnpm --silent lint:structure",
    "lint:structure": "alint check --no-spawn",
    "lint:fix": "biome check --write .",
    "lint:api": "openapi-linter lint ./src/features/clients-api/implementations/openapi/v1.openapi.json",
    "tsc": "pnpm --silent with-env next typegen && tsc --noEmit && tsc --noEmit -p e2e",
    "postinstall": "pnpm --silent generate:implementations && DISABLE_ERD=true pnpm --silent prisma generate && pnpm --silent prisma:entrepot:generate",
    "test": "vitest run --project \"!integration\"",
    "test:integration": "vitest run --project integration",
    "test:cucumber": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' dotenv -e ./.env -- cucumber-js",
    "test:cucumber:coverage": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' c8 dotenv -e ./.env -- cucumber-js",
    "with-env": "dotenv --",
    "with-remote-env": "dotenv -e .env.remote -e .env --",
    "prisma": "pnpm --silent with-env prisma",
    "prisma:entrepot:generate": "pnpm --silent prisma generate --config ./prisma/entrepot/prisma.config.ts",
    "db:migrate-deploy": "pnpm --silent db:baseline-main && pnpm --silent prisma migrate deploy && pnpm --silent prisma db execute --file ./prisma/sql/move-prisma-migrations-to-coop.sql",
    "db:baseline-main": "bash ./scripts/baseline-main.sh",
    "db:check-main-drift": "bash ./scripts/main-drift.sh check",
    "db:refresh-main-reference": "bash ./scripts/main-drift.sh refresh",
    "erd": "DISABLE_ERD= pnpm prisma generate",
    "api-v1-doc:generate": "next-swagger-doc-cli --config ./src/features/clients-api/implementations/openapi/v1.openapi-config.json --output ./src/features/clients-api/implementations/openapi/v1.openapi.json && biome format --write ./src/features/clients-api/implementations/openapi/v1.openapi.json",
    "standalone:configure": "cp -R ./public ./.next/standalone/public && cp -R ./.next/static ./.next/standalone/.next/static",
    "standalone:start": "HOSTNAME=\"0.0.0.0\" dotenv -- node ./.next/standalone/server.js",
    "cli": "TSX_TSCONFIG_PATH=./tsconfig.node.json dotenv -- tsx --import ./src/configuration/telemetry/instrument/cli.ts src/cli/index.ts",
    "clean": "rm -rf node_modules",
    "lint:commit": "commitlint --from origin/main",
    "test:e2e": "pnpm cy open",
    "scw": "pnpm with-env scw",
    "fixtures:load": "TSX_TSCONFIG_PATH=./tsconfig.node.json dotenv -- tsx src/cli/fixtures/load.ts",
    "jobs:run": "TSX_TSCONFIG_PATH=./tsconfig.node.json dotenv -- tsx src/jobs/run-job.ts",
    "prisma:generate-migration": "pnpm --silent prisma migrate dev --name",
    "db:init": "pnpm prisma generate && pnpm db:migrate-deploy",
    "docker:start": "docker compose up -d --wait",
    "docker:stop": "docker compose down",
    "docker:reset": "pnpm docker:stop && docker volume rm coop_pgdata && pnpm docker:start && pnpm db:init",
    "prepare": "husky",
    "prestorybook": "react-dsfr update-icons --silent",
    "storybook": "storybook dev -p 6006 --no-open",
    "prebuild-storybook": "react-dsfr update-icons --silent",
    "build-storybook": "storybook build",
    "chromatic": "dotenv -- chromatic --exit-zero-on-changes --exit-once-uploaded",
    "cy": "dotenv -e .env -e e2e/cypress.env -- cypress",
    "analyze": "pnpm --silent with-env next analyze",
    "api:bruno": "bash ./scripts/api-bruno.sh",
    "lint:adr": "bash ./scripts/lint-adr.sh"
  },
  "dependencies": {
    "@arckit/nextjs": "^2.2.2",
    "@arckit/pipeline": "^1.0.0",
    "@arckit/resultset": "^2.1.0",
    "@arckit/telemetry": "^1.5.0",
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@codegouvfr/react-dsfr": "^1.35.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@faire/mjml-react": "^4.0.1",
    "@gouvfr-anct/lieux-de-mediation-numerique": "^4.4.0",
    "@gouvfr-anct/timetable-to-osm-opening-hours": "^2.1.1",
    "@hookform/resolvers": "^7.0.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/api-reference-react": "^0.9.87",
    "@sentry/nextjs": "^11.10.0",
    "@sentry/node": "^11.10.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@tanstack/react-form": "^1.33.5",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@zumer/snapdom": "^3.0.0",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "csv-stringify": "^6.8.3",
    "cypress-real-events": "^1.15.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-cli": "^11.0.0",
    "downshift": "^9.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.0",
    "html-minifier-terser": "^7.2.0",
    "html-to-text": "^10.0.1",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "lodash-es": "^4.18.1",
    "mjml": "^5.4.1",
    "nanoid": "^6.0.1",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-swagger-doc": "^0.5.0",
    "nodemailer": "^10.0.10",
    "nuqs": "2.10.2",
    "p-retry": "^9.0.0",
    "p-throttle": "^8.1.1",
    "pako": "^3.0.2",
    "pino": "^10.4.0",
    "piqure": "^2.3.0",
    "postgres-array": "3.0.4",
    "prisma": "7.10.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-calendar": "^6.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "superjson": "2.2.6",
    "tsafe": "^1.8.12",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arckit/cucumber": "^1.0.1",
    "@asamarts/alint": "0.23.0",
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cucumber/cucumber": "^13.2.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@superfaceai/openapi-linter": "^0.1.0",
    "@testing-library/cypress": "^10.1.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/html-to-text": "^9.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "5.1.0",
    "c8": "^12.0.0",
    "chromatic": "^18.13.9",
    "commander": "^15.0.0",
    "cypress": "^16.1.0",
    "cypress-file-upload": "^5.0.8",
    "cypress-split": "^1.25.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.24.0",
    "prisma-erd-generator": "^3.2.1",
    "sass": "^1.107.1",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "webpack": "5.112.2"
  }
}
