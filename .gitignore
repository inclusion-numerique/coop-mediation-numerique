# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# ⚠️ Keep in sync with .eslintignore

var
# dependencies
node_modules
.pnp
.pnp.js

# testing
/coverage
/coverage-reports
**/coverage
**/coverage-cucumber
**/junit

# production
/build

# misc
.DS_Store
*.pem

# terraform
.tfvars
.tfvars.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.remote

# vercel
.vercel

# storybook
build-storybook.log

# typescript
*.tsbuildinfo

# IDE
.bruno
.idea

# audit output
output/
.vscode

storybook-static

# next
/.next/
/apps/web/.next/

/apps/web/public/dsfr

# e2e
/packages/e2e/cypress/videos
/packages/e2e/cypress/screenshots
/packages/e2e/.next/
/packages/e2e/cypress/downloads

/packages/cdk/cdktf.out/
packages/cdk/cdk.out.json
terraform.*.tfstate

# ui
/packages/ui/.next
/packages/ui/public/dsfr

# http rest client
/*.http

# AI and code generation
# Système d'automatisation de refacto versionné ; settings.local.json reste ignoré
/.claude/*
!/.claude/conventions
!/.claude/agents
!/.claude/skills
!/.claude/workflows
CLAUDE.md

# prisma ERD (generated, regenerate with `pnpm -F web erd`)
/apps/web/prisma/ERD.md
/apps/web/prisma/ERD.svg
/apps/web/prisma/ERD.pdf

/apps/web/src/generated

# workspace scratch (notes de refacto, scripts one-off, artefacts d'outils)
/refactor/
/scripts/
/.playwright-mcp/

# dossiers de travail par sujet (relevés, exports, notes) — jamais dans le home
/travail/
/infrastructure/.terraform
/infrastructure/.tfvars.json
/infrastructure/*.tfplan
/infrastructure/outputs.json
