/build

# misc
.DS_Store
*.pem

# terraform
.tfvars
.tfvars.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.remote

# vercel
.vercel

# storybook
build-storybook.log

# typescript
*.tsbuildinfo

# IDE
.bruno
.idea

