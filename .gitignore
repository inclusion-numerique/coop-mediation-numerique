/e2e/cypress/videos
/e2e/cypress/screenshots
/e2e/.next/
/e2e/cypress/downloads


# ui

# http rest client
/*.http

# AI and code generation
# Système d'automatisation de refacto versionné ; settings.local.json reste ignoré
/.claude/*
!/.claude/conventions
!/.claude/agents
!/.claude/skills
!/.claude/workflows

