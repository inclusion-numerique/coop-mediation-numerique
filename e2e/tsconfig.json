{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "@testing-library/cypress", "node"],
    "paths": {
      "@/*": ["../src/*"],
      "@e2e/*": ["./*"]
    }
  },
  "include": [
    "../next-env.d.ts",
    "../src/configuration/environnement/process-env.d.ts",
    "../src/configuration/dsfr/react-dsfr.d.ts",
    "../cypress.config.ts",
    "./**/*.ts",
    "./**/*.json",
    "../src/app/**/page.test.ts",
    "../src/app/**/route.test.ts",
    "../src/**/*.cy.tsx"
  ],
  "exclude": ["../node_modules"]
}
