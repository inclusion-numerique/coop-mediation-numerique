{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "@testing-library/cypress", "node"],
    "paths": {
      "@/*": ["../src/*"],
      "@e2e/*": ["./*"]
    }
  },
  "include": [
    "../next-env.d.ts",
    "../cypress.config.ts",
    "./**/*.ts",
    "./**/*.json",
    "../src/**/e2e/*.ts",
    "../src/app/**/*.e2e.ts",
    "../src/**/*.cy.tsx"
  ]
}
