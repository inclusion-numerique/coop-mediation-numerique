{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": "//",
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "javascript": {
        "globals": [
          "cy",
          "Cypress",
          "JQuery",
          "afterEach",
          "afterAll",
          "beforeEach",
          "beforeAll",
          "before",
          "after",
          "describe",
          "expect",
          "it"
        ]
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "off"
      }
    }
  }
}
