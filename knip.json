{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/jobs/run-job.ts!",
    "src/jobs/verifier-le-bundle.ts!",
    "src/configuration/telemetry/error-reporter/*/index.*.ts!",
    "src/libraries/server-only-cli/index.ts",
    "src/**/*.{steps,cucumber}.ts",
    "e2e/proconnect-simule/serveur.ts",
    "e2e/tasks/task-executor.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "docs/*.mjs"
  ],
  "cypress": {
    "config": [],
    "entry": [
      "cypress.config.ts",
      "e2e/support/{e2e,component}.ts",
      "e2e/*.e2e.ts",
      "src/app/**/page.test.ts",
      "src/app/**/route.test.ts",
      "src/**/*.cy.tsx"
    ]
  },
  "ignoreBinaries": ["scw", "tofu", "dot"],
  "ignoreDependencies": ["markdownlint-cli2"],
  "astro": {
    "config": ["docs/astro.config.mjs"],
    "entry": ["docs/content.config.mjs"]
  }
}
