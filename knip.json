{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/jobs/run-job.ts!",
    "src/jobs/verifier-le-bundle.ts!",
    "src/configuration/telemetry/error-reporter/*/index.*.ts!",
    "src/libraries/server-only-cli/index.ts",
    "src/**/*.{steps,cucumber}.ts",
    "e2e/proconnect-simule/serveur.ts",
    "e2e/tasks/taskExecutor.ts"
  ],
  "project": ["src/**/*.{ts,tsx,mts}!", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "cypress": {
    "config": [],
    "entry": [
      "cypress.config.ts",
      "e2e/support/{e2e,component}.ts",
      "src/**/e2e/*.e2e.ts",
      "src/app/**/*.e2e.ts",
      "src/**/*.cy.tsx"
    ]
  },
  "ignoreBinaries": ["scw", "tofu"],
  "ignoreDependencies": ["markdownlint-cli2"]
}
