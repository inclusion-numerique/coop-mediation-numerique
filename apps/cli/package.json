{
  "name": "@app/cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "dotenv -e ../../.env -- tsx --import ./instrument.mts src/index.ts",
    "cli:target-deployment": "dotenv -e ../../.env -- bash -c 'export DATABASE_URL=$CLI_TARGET_DEPLOYMENT_DATABASE_URL && tsx --import ./instrument.mts src/index.ts \"$@\"' --",
    "lint": "biome check src",
    "tsc": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "tsc"
  },
  "engines": {
    "node": "^25.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@commander-js/extra-typings": "^13.1.0",
    "@inquirer/prompts": "^8.5.2",
    "@octokit/core": "^6.1.6",
    "@octokit/plugin-rest-endpoint-methods": "^14.0.0",
    "@sentry/node": "^10.67.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "csv-stringify": "^6.8.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lodash-es": "^4.18.1",
    "mongodb": "^5.9.2",
    "p-retry": "^8.0.0",
    "picocolors": "^1.1.1",
    "slugify": "^1.6.9",
    "tsx": "^4.23.1",
    "undici": "^7.28.0",
    "uuid": "^14.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
