{
  "name": "@app/web",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --silent with-env next dev",
    "build": "pnpm --silent with-env next build",
    "build:analyze": "ANALYZE=true pnpm --silent with-env next build",
    "modclean": "modclean -Pr",
    "modclean:root": "modclean -Pr -p ./../..",
    "start": "next start",
    "lint": "biome check src && openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json",
    "lint:biome": "biome format src && biome check src",
    "lint:fix": "biome format src --fix && biome check --write src",
    "lint:api": "openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json",
    "tsc": "tsc --noEmit",
    "postinstall": "pnpm --silent setup:dsfr && DISABLE_ERD=true pnpm --silent prisma generate && pnpm --silent prisma:entrepot:generate",
    "setup:dsfr": "bash ../../setup-dsfr.sh",
    "test": "jest -c jest.unit.config.ts",
    "test:integration": "jest -c jest.integration.config.ts --passWithNoTests --runInBand",
    "test:cucumber": "NODE_OPTIONS='--import tsx/esm' dotenv -e ../../.env -- cucumber-js",
    "with-env": "dotenv -e ../../.env --",
    "with-remote-env": "dotenv -e ../../.env.remote -e ../../.env --",
    "prisma": "pnpm --silent with-env prisma",
    "prisma:entrepot:generate": "pnpm --silent prisma generate --schema ./prisma/entrepot/schema.prisma",
    "db:migrate-deploy": "pnpm --silent prisma migrate deploy && pnpm --silent prisma db execute --schema ./prisma/schema.prisma --file ./prisma/sql/move-prisma-migrations-to-coop.sql",
    "erd": "pnpm erd:md && pnpm erd:svg && pnpm erd:pdf",
    "erd:md": "DISABLE_ERD= pnpm prisma generate",
    "erd:svg": "mmdc -i prisma/ERD.md -o prisma/ERD.svg && mv prisma/ERD-1.svg prisma/ERD.svg",
    "erd:pdf": "mmdc -i prisma/ERD.md -o prisma/ERD.pdf -f && mv prisma/ERD-1.pdf prisma/ERD.pdf",
    "cy": "pnpm --silent with-env cypress",
    "api-v1-doc:generate": "next-swagger-doc-cli --config ./src/app/api/v1/documentation/apiV1DocConfig.json --output ./src/app/api/v1/documentation/v1.openapi.json",
    "standalone:configure": "cp -R ./public ./.next/standalone/apps/web/public && cp -R ./.next/static ./.next/standalone/apps/web/.next/static",
    "standalone:start": "HOSTNAME=\"0.0.0.0\" ../../node_modules/.bin/dotenv -e ../../.env -- node ./.next/standalone/apps/web/server.js"
  },
  "engines": {
    "node": "^25.4"
  },
  "dependencies": {
    "@app/emails": "workspace:^",
    "@arckit/resultset": "^2.1.0",
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@gouvfr-anct/lieux-de-mediation-numerique": "^2.3.0",
    "@gouvfr-anct/timetable-to-osm-opening-hours": "^2.1.0",
    "@gouvfr/dsfr": "~1.14.4",
    "@hookform/resolvers": "^4.1.3",
    "@next/bundle-analyzer": "^15.5.22",
    "@prisma/client": "6.13.0",
    "@radix-ui/react-popover": "^1.1.20",
    "@scalar/nextjs-api-reference": "^0.11.11",
    "@sentry/nextjs": "^9.47.1",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.3",
    "@tiptap/react": "^2.27.2",
    "@trpc/client": "11.1.2",
    "@trpc/react-query": "11.1.2",
    "@trpc/server": "11.1.2",
    "@zumer/snapdom": "^2.16.0",
    "axios": "^1.18.1",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "client-only": "^0.0.1",
    "cookie": "^1.1.1",
    "copy": "^0.3.2",
    "csv-stringify": "^6.8.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debounce-promise": "^3.1.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "html-minifier": "^4.0.0",
    "html-to-text": "^10.0.0",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "1.13.7",
    "lodash-es": "^4.18.1",
    "mjml": "^4.18.0",
    "mongodb": "^5.9.2",
    "nanoid": "^6.0.0",
    "next": "^15.5.22",
    "next-auth": "^4.24.15",
    "next-swagger-doc": "^0.4.1",
    "nodemailer": "^9.0.3",
    "opening_hours": "^3.14.0",
    "p-retry": "^8.0.0",
    "p-throttle": "^8.1.0",
    "pako": "^3.0.1",
    "piqure": "^2.3.0",
    "postcss": "^8.5.21",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.6.1",
    "prisma": "6.13.0",
    "proj4": "^2.20.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-hot-toast": "^2.6.0",
    "react-use-css-custom-property": "^0.1.1",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "superjson": "2.2.2",
    "undici": "^7.29.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@arckit/cucumber": "^1.0.1",
    "@cucumber/cucumber": "^12.9.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@superfaceai/openapi-linter": "^0.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/cookie": "^1.0.0",
    "@types/debounce-promise": "^3.1.9",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/testing-library__jest-dom": "^6.0.0",
    "eslint": "^9.39.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "modclean": "3.0.0-beta.1",
    "prisma-erd-generator": "^2.4.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
