{
  "name": "@app/web",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --silent with-env next dev",
    "build": "pnpm --silent with-env next build",
    "build:analyze": "ANALYZE=true pnpm --silent with-env next build --webpack",
    "modclean": "modclean -Pr",
    "modclean:root": "modclean -Pr -p ./../..",
    "start": "next start",
    "lint": "biome check src && openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json",
    "lint:biome": "biome format src && biome check src",
    "lint:fix": "biome format src --fix && biome check --write src",
    "lint:api": "openapi-linter lint ./src/app/api/v1/documentation/v1.openapi.json",
    "tsc": "tsc --noEmit",
    "postinstall": "pnpm --silent setup:dsfr && DISABLE_ERD=true pnpm --silent prisma generate && pnpm --silent prisma:entrepot:generate",
    "setup:dsfr": "bash ../../setup-dsfr.sh",
    "test": "jest -c jest.unit.config.ts",
    "test:integration": "jest -c jest.integration.config.ts --passWithNoTests --runInBand",
    "test:cucumber": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' dotenv -e ../../.env -- cucumber-js",
    "test:cucumber:coverage": "TSX_TSCONFIG_PATH=./tsconfig.node.json NODE_OPTIONS='--import tsx/esm' c8 dotenv -e ../../.env -- cucumber-js",
    "with-env": "dotenv -e ../../.env --",
    "with-remote-env": "dotenv -e ../../.env.remote -e ../../.env --",
    "prisma": "pnpm --silent with-env prisma",
    "prisma:entrepot:generate": "pnpm --silent prisma generate --config ./prisma/entrepot/prisma.config.ts",
    "db:migrate-deploy": "pnpm --silent db:baseline-main && pnpm --silent prisma migrate deploy && pnpm --silent prisma db execute --file ./prisma/sql/move-prisma-migrations-to-coop.sql",
    "db:baseline-main": "bash ./prisma/baseline-main.sh",
    "db:check-main-drift": "bash ./prisma/main-drift.sh check",
    "db:refresh-main-reference": "bash ./prisma/main-drift.sh refresh",
    "erd": "pnpm erd:md && pnpm erd:svg && pnpm erd:pdf",
    "erd:md": "DISABLE_ERD= pnpm prisma generate",
    "erd:svg": "mmdc -i prisma/ERD.md -o prisma/ERD.svg && mv prisma/ERD-1.svg prisma/ERD.svg",
    "erd:pdf": "mmdc -i prisma/ERD.md -o prisma/ERD.pdf -f && mv prisma/ERD-1.pdf prisma/ERD.pdf",
    "cy": "pnpm --silent with-env cypress",
    "api-v1-doc:generate": "next-swagger-doc-cli --config ./src/app/api/v1/documentation/apiV1DocConfig.json --output ./src/app/api/v1/documentation/v1.openapi.json && biome format --write ./src/app/api/v1/documentation/v1.openapi.json",
    "standalone:configure": "cp -R ./public ./.next/standalone/apps/web/public && cp -R ./.next/static ./.next/standalone/apps/web/.next/static",
    "standalone:start": "HOSTNAME=\"0.0.0.0\" ../../node_modules/.bin/dotenv -e ../../.env -- node ./.next/standalone/apps/web/server.js"
  },
  "engines": {
    "node": "^24.19"
  },
  "dependencies": {
    "@app/emails": "workspace:^",
    "@arckit/resultset": "^2.1.0",
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@codegouvfr/react-dsfr": "^1.35.0",
    "@gouvfr-anct/lieux-de-mediation-numerique": "^4.4.0",
    "@gouvfr-anct/timetable-to-osm-opening-hours": "^2.1.0",
    "@gouvfr/dsfr": "~1.14.4",
    "@hookform/resolvers": "^5.9.1",
    "@next/bundle-analyzer": "^16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@scalar/nextjs-api-reference": "^0.11.18",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/react": "^3.31.3",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "@zumer/snapdom": "^3.0.0",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "client-only": "^0.0.1",
    "cookie": "^2.0.1",
    "copy": "^0.3.2",
    "csv-stringify": "^6.8.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debounce-promise": "^3.1.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.4.0",
    "html-to-text": "^10.0.1",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "lodash-es": "^4.18.1",
    "mjml": "^5.4.1",
    "mongodb": "^5.9.2",
    "nanoid": "^6.0.1",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-swagger-doc": "^0.4.1",
    "nodemailer": "^10.0.10",
    "p-retry": "^8.0.1",
    "p-throttle": "^8.1.1",
    "pako": "^3.0.2",
    "piqure": "^2.3.0",
    "postcss": "8.5.23",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postgres-array": "3.0.4",
    "prisma": "7.10.0",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "react-use-css-custom-property": "^0.1.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "superjson": "2.2.6",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arckit/cucumber": "^1.0.1",
    "@cucumber/cucumber": "^13.2.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@storybook/react": "^10.6.0",
    "@superfaceai/openapi-linter": "^0.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/debounce-promise": "^3.1.9",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "modclean": "3.0.0-beta.1",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.5.3",
    "prisma-erd-generator": "^3.2.1",
    "storybook": "^10.6.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
